if(NOT EXISTS "${MAP}")
    message(FATAL_ERROR "Runtime2 data-only validation requires its actual linker map.")
endif()
file(READ "${MAP}" CONTENT)
foreach(MODULE IN ITEMS Runtime RuntimeAssets)
    if(NOT CONTENT MATCHES "LiteLayer:${MODULE}\\.cpp\\.obj")
        message(FATAL_ERROR "Runtime2 consumer did not link ${MODULE}.")
    endif()
endforeach()
if(CONTENT MATCHES "LiteLayer:(Engine|Geometry|ShaderPipeline|NativePipeline|Environment|AssetContainer)\\.cpp\\.obj"
   OR CONTENT MATCHES "LiteAssetDecoder|LiteShaderCompiler|json::|nlohmann|bgfx:|RmlUi|AppRuntime|napi_")
    message(FATAL_ERROR "Runtime2 data-only consumer pulled a decoder/JSON/renderer/compiler/VM.")
endif()
message(STATUS "Runtime2 data-only link: no decoder/JSON/renderer/compiler/VM implementation.")
